# Required for local development
PORT=3000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=30d
ALLOW_PUBLIC_SHOP_REGISTRATION=false

# Required once on a fresh database so you can create the first shop and owner.
# Use a password of at least 12 characters. Leave all three blank only if an
# existing database already has a Super Admin account.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional but recommended when shops use their own Google AI Studio keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this value stable; changing it makes existing encrypted shop keys unreadable.
SHOP_SECRET_ENCRYPTION_KEY=
# GEMINI_MODEL=your-supported-model-name

# Optional email password-reset delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_SECURE=false

# WhatsApp uses a QR-linked Baileys session per shop, persisted in MongoDB.
